PORT=5000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017/homescooter

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_homescooter_2026
JWT_EXPIRES_IN=7d
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# File Upload Configuration
MAX_FILE_SIZE=5242880

# Third-Party Integrations
WHATSAPP_API_TOKEN=your_whatsapp_api_token
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_FROM_EMAIL=noreply@homeandscooterapp.online
SMTP_FROM_NAME="Home & Scooter Support"
APP_RESET_URL=http://localhost:5027/api/v1/user/auth/reset-password-web
